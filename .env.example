# Copy to .env.local (never commit real values).

# ---- Lead capture (/api/leads) ----
# Configure at least one destination. With none, the enquiry forms show an
# honest "not connected" message with a pre-filled email fallback.

# Option A: any HTTPS webhook (Zapier, Make, n8n, Google Apps Script, your CRM).
# Receives POST {"type":"lead","lead":{...}}.
LEAD_WEBHOOK_URL=
# Optional: signs the body; verify X-Squadify-Signature = "sha256=" + HMAC-SHA256(body, secret).
LEAD_WEBHOOK_SECRET=

# Option B: email notifications via Resend (https://resend.com, free tier available).
# All three are required; the from address must be on a domain verified in Resend.
RESEND_API_KEY=
LEAD_NOTIFY_EMAIL=
LEAD_FROM_EMAIL=

# ---- Site assistant (/api/chat), optional ----
# Without a key the assistant answers locally from src/lib/assistant/knowledge.ts.
# With a key, answers come from Claude, grounded in that same knowledge base (paid API usage).
ANTHROPIC_API_KEY=
# Optional model override (default claude-opus-5-5; claude-haiku-5-5 is far cheaper).
ASSISTANT_MODEL=
